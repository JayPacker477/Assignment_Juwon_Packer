                </mxCell>
                <mxCell id="hl-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="Medium" vertex="1">
