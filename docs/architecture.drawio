                </mxCell>
                <mxCell id="hl-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="High skill" vertex="1">
