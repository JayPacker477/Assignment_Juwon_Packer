                <mxCell id="hl-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" value="&lt;b style=&#39;font-size:22px&#39;&gt;Travel Disruption Radar — how it works&lt;/b&gt;&lt;br&gt;&lt;span style=&#39;color:#666&#39;&gt;One question: “Will something disrupt my trip, how sure are we, and what should I do?”&lt;/span&gt;" vertex="1">
                    <mxGeometry height="40" width="1200" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="hl-2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;shape=mxgraph.basic.rect;" value="&lt;b&gt;Traveler / Ops&lt;/b&gt;&lt;br&gt;&lt;br&gt;“NYC to San Francisco tomorrow”" vertex="1">
                    <mxGeometry height="110" width="170" x="40" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="hl-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;① Understand the trip&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI turns free text into airports + date.&lt;br&gt;Cities expand to metro alternates (JFK / LGA / EWR)." vertex="1">
                    <mxGeometry height="110" width="190" x="260" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="hl-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;② Gather live evidence&lt;/b&gt; (in parallel)&lt;br&gt;&lt;br&gt;&lt;div style=&#39;text-align:left&#39;&gt;• &lt;b&gt;FAA&lt;/b&gt; – ground stops, delay programs now&lt;br&gt;• &lt;b&gt;NWS&lt;/b&gt; – official alerts &amp;amp; forecast&lt;br&gt;• &lt;b&gt;Aviation TAFs&lt;/b&gt; – airport forecast, next ~30h&lt;br&gt;• &lt;b&gt;Open-Meteo&lt;/b&gt; – model outlook to 16 days&lt;br&gt;• &lt;b&gt;SIGMETs&lt;/b&gt; – hazards crossing the flight path&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="250" x="500" y="90" as="geometry"/>
                </mxCell>
                <mxCell id="hl-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;③ Score the risk&lt;/b&gt;&lt;br&gt;&lt;br&gt;Transparent rules: severity per signal, does it apply on the trip date, confidence by lead time." vertex="1">
                    <mxGeometry height="110" width="200" x="800" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="hl-6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;④ Explain &amp;amp; recommend&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI writes the briefing, citing evidence IDs. Uncited claims are removed." vertex="1">
                    <mxGeometry height="110" width="210" x="1050" y="120" as="geometry"/>
                </mxCell>
                <mxCell id="hl-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;⑤ What the user sees&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&#39;text-align:left&#39;&gt;• Risk level: LOW / MODERATE / HIGH / UNKNOWN&lt;br&gt;• Confidence + why&lt;br&gt;• Key risks → evidence&lt;br&gt;• Actions &amp;amp; when to take them&lt;br&gt;• Map, alternates, raw source data&lt;/div&gt;" vertex="1">
                    <mxGeometry height="170" width="220" x="1310" y="90" as="geometry"/>
