                <mxCell id="hl-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;" value="&lt;b style=&#39;font-size:15px&#39;&gt;Which evidence is usable depends on how far away the trip is&lt;/b&gt; &lt;span style=&#39;color:#666&#39;&gt;(this is how we communicate uncertainty)&lt;/span&gt;" vertex="1">
