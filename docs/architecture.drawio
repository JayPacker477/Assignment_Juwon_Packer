                <mxCell id="hl-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=11;" value="Alerts only if already issued" vertex="1">
