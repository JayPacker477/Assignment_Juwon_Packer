                </mxCell>
                <mxCell id="hl-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" value="Low" vertex="1">
                    <mxGeometry height="32" width="224" x="930" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="hl-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" value="None → UNKNOWN" vertex="1">
                    <mxGeometry height="32" width="224" x="1160" y="570" as="geometry"/>
                </mxCell>
                <mxCell id="hl-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="&lt;b&gt;Overall confidence:&lt;/b&gt;  high (today / tomorrow)  →  medium (2–4 days)  →  low (5–15 days)  →  very low (16+).  Any failed source lowers it one notch." vertex="1">
                    <mxGeometry height="34" width="1144" x="240" y="615" as="geometry"/>
                </mxCell>
                <mxCell id="hl-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#ffffff;strokeColor=#333333;spacing=12;" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Design principles&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Rules decide, AI explains.&lt;/b&gt; The headline level is reproducible and auditable; the LLM adds judgement, narrative and actions — and can flag disagreement as a visible “second opinion”.&lt;br&gt;2. &lt;b&gt;Every claim is traceable.&lt;/b&gt; Each finding has an ID, source link, timestamp and raw data; AI citations are validated server-side.&lt;br&gt;3. &lt;b&gt;No data ≠ low risk.&lt;/b&gt; Beyond forecast horizons the answer is UNKNOWN, not LOW.&lt;br&gt;4. &lt;b&gt;Relevance filtering.&lt;/b&gt; e.g. FAA “closures” that only affect general aviation are shown as context, not risk.&lt;br&gt;5. &lt;b&gt;Degrade gracefully.&lt;/b&gt; Any source (or the AI) can fail; the user is told and confidence drops.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="700" x="40" y="690" as="geometry"/>
                </mxCell>
                <mxCell id="hl-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;spacing=12;" value="&lt;div style=&#39;text-align:left&#39;&gt;&lt;b style=&#39;font-size:14px&#39;&gt;Where AI is (and isn&#39;t) used&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AI:&lt;/b&gt; understanding messy trip requests (“NYC → SF next Fri”); synthesising many weak signals into a short, proportional briefing; turning evidence into concrete actions (waivers, earlier flights, alternate airports); an independent second opinion on the level.&lt;br&gt;&lt;br&gt;&lt;b&gt;Not AI:&lt;/b&gt; fetching data, deciding what applies to the trip date, severity thresholds, the headline risk level, confidence. These need to be deterministic, testable and explainable to an Ops team.&lt;/div&gt;" vertex="1">
                    <mxGeometry height="190" width="750" x="780" y="690" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
