# Required for the AI layer (trip parsing + briefing). Without it the app runs with a rule-based fallback.
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_PARSE_MODEL=claude-haiku-4-5
# api.weather.gov asks for an identifying User-Agent with contact info
HTTP_USER_AGENT=travel-disruption-prototype/0.1 (contact: you@example.com)
